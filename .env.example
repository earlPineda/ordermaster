# ---------------------------------------------------------------------------
# Matcha Avenue Cafe - environment variables
# Copy this file to .env for local runs (`.env` is gitignored), or add these
# keys in the Render Dashboard under Settings -> Environment when hosting.
# Every value is optional - the app degrades gracefully when a key is missing.
# ---------------------------------------------------------------------------

# GEMINI_API_KEY: powers the AI ordering assistant and the Meta AI auto-replies.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: public URL where the app is hosted (used for self-referential links).
APP_URL="https://matcha-avenue-cafe.onrender.com"

# GOOGLE_MAPS_PLATFORM_KEY: read at BUILD time by vite.config.ts and baked into
# the client bundle. The delivery pin map works without it (Leaflet + Google
# raster tiles); a key enables the official Google Maps Platform features.
GOOGLE_MAPS_PLATFORM_KEY=

# --------------------------- Meta / Messenger ------------------------------
# Facebook Page ID: 61592982062259
# (https://www.facebook.com/profile.php?id=61592982062259)
FB_PAGE_ID=61592982062259
FB_PAGE_ACCESS_TOKEN=
FB_VERIFY_TOKEN=matcha_avenue_meta_ai_secret_verify_token

# ------------------------------- Server ------------------------------------
# PORT is injected by the hosting platform. Locally it defaults to 3000 and
# automatically moves to the next free port when 3000 is already in use.
# HOST defaults to 0.0.0.0 so the app is reachable from other devices.
# PORT=3000
# HOST=0.0.0.0
